#!/bin/sh
# Tracked pre-commit hook — survives `git clone` (unlike the old untracked
# .git/hooks/pre-commit it replaces). Activate once per clone:
#   git config core.hooksPath .githooks
# See docs/plans/architecture-score-9-remediation-plan.md Phase 0.2.

# DISABLED BY DEFAULT as of 2026-08-27. Multiple peer sessions share this
# checkout and spawn git subprocesses concurrently, causing hook deadlock and
# timeouts on every commit. Gating commits on it costs more than it catches.
# Run scan-secrets.py directly during development for secrets checking.
#
# Opt in for hook run:   REASONER_PRECOMMIT=1 git commit
# Or run it directly:    bash scripts/scan-secrets.py . && python scripts/check_skill_maps.py
#
# NOTE: with this off, secrets are only caught by the push hook (scan-secrets).
# Re-enable by deleting the guard below once concurrent access is resolved.

[ "$REASONER_PRECOMMIT" = "1" ] || exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$SCRIPT_DIR" || exit 1

python scripts/scan-secrets.py .
RESULT=$?
if [ $RESULT -ne 0 ]; then
    echo ""
    echo "ERROR: Secrets detected in staged changes."
    echo "Remove them before committing, or use --no-verify to bypass."
    exit 1
fi

# Warn (never block) when a folder map in .claude/skills/ no longer matches the tree.
python scripts/check_skill_maps.py || true

exit 0

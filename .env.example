# ═══════════════════════════════════════════════════════════════════════════════
# API Keys - NEVER commit this file with real values!
# ═══════════════════════════════════════════════════════════════════════════════

# ── RECOMMENDED: OpenRouter (unified access to 346+ models) ──────────────────
# Get key: https://openrouter.ai/keys
# Single key replaces all individual provider keys below.
# Use presets: or-ultra-budget, or-budget-plus, or-balanced ⭐, or-quality, or-max-quality
OPENROUTER_API_KEY=sk-or-v1-...

# ── Individual Provider Keys (still supported for direct API access) ──────────
# Only set these if NOT using OpenRouter, or for mixed setups.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=...

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Mistral AI - https://console.mistral.ai/
MISTRAL_API_KEY=...

# xAI Grok - https://console.x.ai/
XAI_API_KEY=...

# Perplexity - https://www.perplexity.ai/
# Note: Search now routes through OpenRouter (uses OPENROUTER_API_KEY).
# Only needed if using Perplexity embeddings via neuro.yaml.
PERPLEXITY_API_KEY=pplx-...

# Alibaba Qwen - https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-...

# Moonshot Kimi - https://platform.moonshot.cn/
MOONSHOT_API_KEY=...

# ZhipuAI GLM - https://open.bigmodel.cn/
ZHIPUAI_API_KEY=...

# ═══════════════════════════════════════════════════════════════════════════════
# Admin & Security
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# Admin & Security
# ═══════════════════════════════════════════════════════════════════════════════

# Admin API key for administrative endpoints (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# CSRF token signing secret (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SECRET=

# Field-level encryption for stored credentials (REQUIRED for production).
# With ENVIRONMENT=production, the Postgres and auth stores raise on startup if
# these are unset — rotate by listing keys comma-separated, newest first.
# Generate each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Salt for deterministic lookup hashes of encrypted columns. Must be urlsafe
# base64 (same format as above) — generate it the same way.
BLIND_INDEX_KEY=

# Deployment environment: development | production
# WARNING: Omitting this defaults CORS to development mode (insecure)
ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Debug mode - MUST be false in production
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=127.0.0.1

# Server port
SERVER_PORT=8003

# Uvicorn bind host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Use 127.0.0.1 for localhost-only development.
# Use 0.0.0.0 only when running inside a container or behind a reverse proxy.
UVICORN_HOST=127.0.0.1

# CORS origins — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8003,http://127.0.0.1:8003

# Frontend proxy target (Next.js API routes proxy to this URL)
# Only needed if backend runs on non-default port or different host
REASONER_API_URL=http://localhost:8003

# Comma-separated CIDRs allowed to scrape /api/metrics.
# The observability overlay scrapes from inside the compose network, so it needs
# 172.16.0.0/12 here.
METRICS_ALLOWED_IPS=127.0.0.1/32,172.16.0.0/12

# ── Web Search backends ───────────────────────────────────────────────────────
# Research and web-grounded presets need at least one of these.
# Brave Search — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Tavily — https://tavily.com (optional secondary backend)
TAVILY_API_KEY=

# OpenRouter analytics headers (optional, used for rank tracking)
OPENROUTER_HTTP_REFERER=https://github.com/Reasoner
OPENROUTER_APP_TITLE=Reasoner

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding & Reranking Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Rerank via OpenRouter /rerank — improves search result relevance
# Uses OPENROUTER_API_KEY (no separate key needed)
# Known-good models: cohere/rerank-4-fast (default, lowest latency)
#                    qwen/qwen3-reranker-8b (open-weight cross-encoder, stronger on long docs)
COHERE_RERANK_ENABLED=true
COHERE_RERANK_MODEL=cohere/rerank-4-fast

# Document Semantic Retrieval (Phase 4) — chunk + embed uploaded files
# Opt-in: set to true to enable semantic retrieval instead of verbatim injection
DOCUMENT_SEMANTIC_RETRIEVAL_ENABLED=false
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_MAX_CHUNKS_PER_FILE=500

# ═══════════════════════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════════════════════

# Requests per minute per client
RATE_LIMIT_PER_MINUTE=60

# Requests per hour per client
RATE_LIMIT_PER_HOUR=1000

# Burst size (short-term allowance)
RATE_LIMIT_BURST=10

# Shared state backend for rate limiter: memory | redis
# memory = unsafe for multi-worker deployments — use redis in production
RATE_LIMITER_MODE=redis

# Shared state backend for circuit breaker: memory | redis
# memory = unsafe for multi-worker deployments — use redis in production
CIRCUIT_BREAKER_MODE=redis

# ═══════════════════════════════════════════════════════════════════════════════
# SaaS Auth (Supabase + Local JWT fallback)
# ═══════════════════════════════════════════════════════════════════════════════

# REQUIRED in production: without Supabase the app falls back to the local HS256
# adapter, which infrastructure/auth/__init__.py refuses to use when
# ENVIRONMENT=production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev JWT (fallback when Supabase unavailable)
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>

# OAuth Providers (frontend — comma-separated list of enabled providers)
# Controls which "Continue with X" buttons appear on login/signup pages.
# Provider must also be enabled in Supabase Dashboard → Authentication → Providers.
# Example: NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=google,github
# Example: NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=google,github,apple
NEXT_PUBLIC_ENABLED_OAUTH_PROVIDERS=google,github,apple

# Gate premium presets on the caller's subscription tier.
# Leave false while premium presets are free for everyone; set true once you
# charge for the Pro tier so free users get a 403 instead of premium access.
PRESET_TIER_ENFORCEMENT_ENABLED=false

# Legacy Compatibility
ENABLE_LEGACY_API_KEY=false  # Set to true only for v1 API client backward compatibility

# ═══════════════════════════════════════════════════════════════════════════════
# Database & Cache
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string (used for quota/auth persistence in SaaS mode)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reasoner
POSTGRES_PASSWORD=

# Asyncpg connection pool size
DB_POOL_SIZE=10

# Redis connection string (used for quota caching, rate limiting, session store)
REDIS_URL=redis://localhost:6379/0

# Where the user-feedback SQLite store lives. Defaults to src/reasoner/feedback.db,
# which is inside the image and therefore lost on redeploy — docker-compose.yml
# overrides it to a mounted volume.
FEEDBACK_DB_PATH=

# Resource limits
MEMORY_LIMIT_MB=1024
MEMORY_WARNING_MB=768
REQUEST_TIMEOUT_SECONDS=300

# ═══════════════════════════════════════════════════════════════════════════════
# Observability
# ═══════════════════════════════════════════════════════════════════════════════
# With ENVIRONMENT=production the app refuses to start unless at least one
# backend below is available. prometheus-client is a hard dependency, so
# /api/metrics satisfies this out of the box — the rest are optional additions.

# Sentry error tracking — https://sentry.io (leave empty to disable)
SENTRY_DSN=
# Sentry tracing sample rate (0.0 = no traces, 1.0 = all traces)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Langfuse LLM tracing — optional, and the SDK is NOT installed by default.
# The subscriber targets the 1.x API, so enable it with:
#   pip install "langfuse>=1.14.0,<2.0.0"
# Both keys must be set or tracing stays off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted Langfuse only; leave empty for Langfuse Cloud.
LANGFUSE_HOST=

# Comma-separated list of trusted proxy IPs.
# Only used to parse X-Forwarded-For. Leave empty to disable.
TRUSTED_PROXIES=

# ═══════════════════════════════════════════════════════════════════════════════
# Spend Caps (P1.9)
# ═══════════════════════════════════════════════════════════════════════════════
# Per-run spend cap in USD. 0 = unlimited.
SPEND_CAP_PER_RUN_USD=0.0
# Per-user monthly spend cap in USD. 0 = unlimited.
SPEND_CAP_MONTHLY_USD=0.0

# ═══════════════════════════════════════════════════════════════════════════════
# Transactional Email (P2.14)
# ═══════════════════════════════════════════════════════════════════════════════
# Resend API key — sign up at https://resend.com
# If unset, emails are logged instead of sent.
RESEND_API_KEY=
# Optional: override the sender address
# RESEND_FROM_ADDRESS=Reasoner <notifications@reasoner.app>
# Admin email for critical alerts (webhook failures, spend cap exceeded, etc.)
NOTIFICATION_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════════
# Stripe Billing
# ═══════════════════════════════════════════════════════════════════════════════

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ═══════════════════════════════════════════════════════════════════════════════
# PayPal Billing
# ═══════════════════════════════════════════════════════════════════════════════

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_PRO_PLAN_ID=
PAYPAL_ENTERPRISE_PLAN_ID=

# Frontend app URL (used for checkout redirects)
APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# Git Integration (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Enable/disable Git integration
ORCHESTRATOR_GIT_ENABLED=false

# Commit strategy: after_each_task | after_phase | after_project | manual
ORCHESTRATOR_GIT_STRATEGY=manual

# Auto-push to remote (use with caution!)
ORCHESTRATOR_GIT_AUTO_PUSH=false

# Environment variables - CRITICAL: Never commit secrets!
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/
# lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Root-level scratch test scripts only (test_all.py, test_parse.py, …).
# Leading slash anchors to repo root so the real suite under tests/ stays tracked.
/test*.py
# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Cache
.cache/
.node_modules
jspm_packages/

# Local config
config/
settings.json

# Git worktrees
.worktrees/

# Local agent profile configs (may contain secrets)
.openclaude-profile.json

# SQLite database files (may contain session data / false-positive secret patterns)
*.db
*.db-shm
*.db-wal

# Generated runtime artifacts — never commit
cache/
src/reasoner/cache/
src/reasoner/history/
graphify-out/
tasks/

# Pipeline output artifacts — from live runs
article-budget*.json
article-premium*.json
reasoner-output-*.md
*.graphify_*.json
autonomous_bug_fix_report.json
method_test_results.json
tmp_req.json

# Reasonix agent artifacts (should not be tracked)
.reasonix/
reasonix.toml

# Runtime upload artifacts (created by the file-upload endpoint at runtime)
src/reasoner/infrastructure/uploads/
src/reasoner/infrastructure/.upload_hash_index.json

# Pipeline ownership map — runtime state written on every run by
# _save_pipeline_owner(). Recreated on demand; a missing file reads as None.
src/reasoner/domain/history/pipeline_owners.json

# Self-healing engine output — regenerable artifacts written to <repo>/healing/
# by src/reasoner/healing/{introspection,test_generation}_engine.py and by the
# generator steps in .github/workflows/self-healing-ci.yml (smoke_tests/,
# failure_pattern_report.md, spec_drift_report.md, healing_summary.json).
# Generated tests are not collected by pytest (testpaths=tests) and are already
# omitted from coverage.
#
# This was src/reasoner/healing/generated_tests/, which was where the engines
# wrongly wrote after the src/ layout moved them a directory deeper. Nothing
# under <repo>/healing/ is tracked.
#
# Leading slash is load-bearing: a bare `healing/` matches a directory of that
# name at ANY depth, which would also ignore the src/reasoner/healing/ source
# package -- silently swallowing any new module added there.
/healing/

# Scratch dir for manual/ad-hoc test scripts
.tmp_manual_temp/

# Separate embedded repo (own .git) — not part of this project
deepseek-harness/

# Coverage run output (coverage.yml / ci-local.sh coverage)
.coverage
coverage.xml
htmlcov/

# --- studio design pipeline (adopt-into-existing.sh) ---
# Backups taken when the studio block was appended / settings merged. Delete once
# you are satisfied with the merged CLAUDE.md and .claude/settings.json.
*.studio-bak
.claude/settings.studio.json
# Gate marker is local state, armed by /adopt per-checkout.
spec/.gate-enabled
# Scaffolding scripts and the source template are tooling, not part of Reasoner.
# vibe-studio-site-template/ carries its own .git — never commit it as a gitlink.
/vibe-studio-site-template/
/bootstrap-web-studio.sh
/harden-hooks-windows.sh
/adopt-into-existing.sh
/website-production-prompt-system.md
# The generic build/ rule above is for compiled output. The studio pipeline ships a
# skill named build/ which must be tracked.
!.claude/skills/build/
!.claude/skills/build/**


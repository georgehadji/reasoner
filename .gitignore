# Environment variables - CRITICAL: Never commit secrets!
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/
# lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Root-level scratch test scripts only (test_all.py, test_parse.py, …).
# Leading slash anchors to repo root so the real suite under tests/ stays tracked.
/test*.py
# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Cache
.cache/
.node_modules
jspm_packages/

# Local config
config/
settings.json

# Git worktrees
.worktrees/

# Local agent profile configs (may contain secrets)
.openclaude-profile.json

# SQLite database files (may contain session data / false-positive secret patterns)
*.db
*.db-shm
*.db-wal

# Generated runtime artifacts — never commit
cache/
src/reasoner/cache/
src/reasoner/history/
graphify-out/
tasks/

# Pipeline output artifacts — from live runs
article-budget*.json
article-premium*.json
reasoner-output-*.md
*.graphify_*.json
autonomous_bug_fix_report.json
method_test_results.json
tmp_req.json

# Reasonix agent artifacts (should not be tracked)
.reasonix/
reasonix.toml

# Runtime upload artifacts (created by the file-upload endpoint at runtime)
src/reasoner/infrastructure/uploads/
src/reasoner/infrastructure/.upload_hash_index.json

# Pipeline ownership map — runtime state written on every run by
# _save_pipeline_owner(). Recreated on demand; a missing file reads as None.
src/reasoner/domain/history/pipeline_owners.json

# Self-healing generated tests — regenerable output of
# healing/test_generation_engine.py. Not collected by pytest (testpaths=tests)
# and already omitted from coverage.
src/reasoner/healing/generated_tests/

# Scratch dir for manual/ad-hoc test scripts
.tmp_manual_temp/

# Separate embedded repo (own .git) — not part of this project
deepseek-harness/

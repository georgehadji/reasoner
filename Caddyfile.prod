# Production Caddyfile with automatic HTTPS
# Critical Enhancement 5.8: auto_https is ON (default) in production
# Critical Enhancement 6.x: HSTS and security headers enforced
# Caddy appends the client to X-Forwarded-For. Put Caddy's address (and any
# load balancer or CDN in front of it) in TRUSTED_PROXIES; see DEPLOY.md.
#
# DOMAIN and ACME_EMAIL come from the caddy container's environment
# (docker-compose.oracle.yml sets them from .env); the defaults are the old
# placeholders, so a hand-edited copy still works.
#
# There is no separate HTTP->HTTPS redirect block: auto-HTTPS already redirects
# port 80. A bare "yourdomain.com { redir ... }" block also binds :443 and,
# adapted, runs before the proxy routes, so every HTTPS request 302'd to itself.

{$DOMAIN:yourdomain.com} {
    # TLS with Let's Encrypt (automatic)
    tls {$ACME_EMAIL:your-email@example.com}

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Body cap at the edge. The backend caps each route itself
    # (BodySizeLimitMiddleware); this only has to cover the largest of those,
    # /api/upload at UPLOAD_MAX_FILES x 50MB + 1MB.
    request_body {
        max_size 520MB
    }

    # Health check endpoint
    handle /api/health {
        reverse_proxy https://backend:8000 {
            transport http {
                tls_trust_pool file /certs/ca.crt
            }
        }
    }

    # API routes → FastAPI
    handle /api/* {
        reverse_proxy https://backend:8000 {
            transport http {
                tls_trust_pool file /certs/ca.crt
            }
        }
    }

    # WebSocket support
    handle /ws/* {
        reverse_proxy https://backend:8000 {
            transport http {
                tls_trust_pool file /certs/ca.crt
            }
        }
    }

    # Everything else → Next.js
    handle {
        reverse_proxy https://frontend:3000 {
            transport http {
                tls_trust_pool file /certs/ca.crt
            }
        }
    }
}
